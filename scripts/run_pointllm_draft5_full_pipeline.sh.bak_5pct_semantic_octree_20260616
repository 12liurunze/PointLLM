#!/usr/bin/env bash
set -euo pipefail

source /root/miniconda3/etc/profile.d/conda.sh
conda activate pointllm

ROOT="${ROOT:-/root/autodl-tmp/eagle-eye-eval-point-compress}"
cd "${ROOT}"

RUN_ID="${RUN_ID:-$(date +%Y%m%d_%H%M%S)}"
DATA_DIR="${DATA_DIR:-/root/autodl-tmp/pointllm_eagle_data_draft5_${RUN_ID}}"
HEAD_DIR="${HEAD_DIR:-/root/autodl-tmp/pointllm_eagle_head_draft5_${RUN_ID}}"
LOG_DIR="${LOG_DIR:-/root/autodl-tmp/pointllm_eagle_logs_draft5_${RUN_ID}}"
OUT_JSONL="${OUT_JSONL:-/root/autodl-tmp/pointllm_compare_eagle_draft5_${RUN_ID}.jsonl}"
SUMMARY_JSON="${SUMMARY_JSON:-/root/autodl-tmp/pointllm_compare_eagle_draft5_${RUN_ID}_summary.json}"
mkdir -p "${LOG_DIR}"

echo "[draft5] run_id=${RUN_ID}"
echo "[draft5] data_dir=${DATA_DIR}"
echo "[draft5] head_dir=${HEAD_DIR}"
echo "[draft5] log_dir=${LOG_DIR}"

export PYTHON_BIN="${PYTHON_BIN:-/root/miniconda3/envs/pointllm/bin/python}"
export POINTLLM_REPO="${POINTLLM_REPO:-/root/autodl-tmp/pointLLM}"
export BASE_MODEL="${BASE_MODEL:-/root/autodl-tmp/point7B_v1.1}"
export POINT_CLOUD_DATA="${POINT_CLOUD_DATA:-/root/autodl-tmp/pointLLM/data/objaverse_data}"
export ANNOTATION="${ANNOTATION:-/root/autodl-tmp/pointLLM/data/anno_data/PointLLM_complex_instruction_70K.json}"
export VAL_JSON="${VAL_JSON:-/root/autodl-tmp/pointLLM/data/anno_data/PointLLM_brief_description_val_200_GT.json}"
export TORCH_DTYPE="${TORCH_DTYPE:-float16}"
export CONVERSATION_TYPES="${CONVERSATION_TYPES:-single_round,multi_round,detailed_description}"

# Spatial-semantic draft-side point-token compression. Keep enough real point
# tokens to preserve local detail, then summarize the rest by semantic octree cells.
export POINT_TOKEN_KEEP_RATIO="${POINT_TOKEN_KEEP_RATIO:-0.25}"
export POINT_TOKEN_SUMMARY_COUNT="${POINT_TOKEN_SUMMARY_COUNT:-8}"
export POINT_TOKEN_TEXT_WEIGHT="${POINT_TOKEN_TEXT_WEIGHT:-0.5}"
export POINT_TOKEN_SPATIAL_MODE="${POINT_TOKEN_SPATIAL_MODE:-semantic_octree}"
unset POINT_TOKEN_KEEP_RATIOS

# Keep the autoregressive/base path uncompressed and avoid the 512-point FPS floor.
export DISABLE_POINT_SPATIAL_COMPRESSION=1
unset POINT_SPATIAL_KEEP_RATIO
unset POINT_SPATIAL_NUM_POINTS
unset POINT_SPATIAL_MIN_POINTS

if [[ "${SKIP_GENERATE:-0}" != "1" ]]; then
  export OUTPUT_DIR="${DATA_DIR}"
  export START="${START:-0}"
  export END="${END:-0}"
  echo "[draft5] generate full training data start $(date)"
  bash scripts/pointllm_generate_data.sh 2>&1 | tee "${LOG_DIR}/01_generate.log"
  echo "[draft5] generated $(find "${DATA_DIR}" -type f \( -name '*.ckpt' -o -name '*.pt' \) | wc -l) files"
else
  echo "[draft5] skip generate; using DATA_DIR=${DATA_DIR}"
fi

echo "[draft5] train start $(date)"
cd "${ROOT}/EAGLE_EYE"
export PYTHONPATH="${POINTLLM_REPO}:${ROOT}/EAGLE_EYE:${PYTHONPATH:-}"
"${PYTHON_BIN}" -m eagle_eye.train.train_pointllm \
  --basepath "${BASE_MODEL}" \
  --pointllm-repo-path "${POINTLLM_REPO}" \
  --tmpdir "${DATA_DIR}" \
  --cpdir "${HEAD_DIR}" \
  --bs "${BATCH_SIZE:-8}" \
  --gradient-accumulation-steps "${GRADIENT_ACCUMULATION_STEPS:-1}" \
  --num-epochs "${NUM_EPOCHS:-8}" \
  --save-freq "${SAVE_FREQ:-1}" \
  --lr "${LR:-1e-5}" \
  --mixed-precision "${MIXED_PRECISION:-no}" \
  ${INIT_HEAD:+--init-head "${INIT_HEAD}"} \
  2>&1 | tee "${LOG_DIR}/02_train.log"

echo "[draft5] compare with autoregressive baseline start $(date)"
cd "${ROOT}"
export HEAD_DIR
export OUTPUT_JSONL="${OUT_JSONL}"
export SUMMARY_JSON
export START="${EVAL_START:-0}"
export END="${EVAL_END:--1}"
export MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-128}"
export MAX_LENGTH="${MAX_LENGTH:-2048}"
export TEMPERATURE="${TEMPERATURE:-0.0}"
export TOP_P="${TOP_P:-0.0}"
export TOP_K="${TOP_K:-0}"
bash scripts/pointllm_compare_eagle.sh 2>&1 | tee "${LOG_DIR}/03_compare.log"

echo "[draft5] done $(date)"
echo "[draft5] summary=${SUMMARY_JSON}"
