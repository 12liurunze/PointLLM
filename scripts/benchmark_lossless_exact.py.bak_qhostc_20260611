import json
import os
import time
import gc
from types import SimpleNamespace

import torch

from eagle_eye.evaluation.compare_pointllm_eagle import (
    build_prompt,
    load_eagle_model,
    load_point_cloud,
    load_pointllm_helpers,
)
from eagle_eye.model import choices as tree_choice_defs
from eagle_eye.model.kv_cache import initialize_past_key_values
from eagle_eye.model.utils import reset_tree_mode


BASELINE_JSONL = "/root/autodl-tmp/pointllm_compare_eagle_compress_nofps_20260602_200451.jsonl"


@torch.inference_mode()
def main():
    benchmark_started = time.perf_counter()
    args = SimpleNamespace(
        base_model_path="/root/autodl-tmp/point7B_v1.1",
        ee_model_path=os.environ.get(
            "BENCH_HEAD",
            "/root/autodl-tmp/pointllm_eagle_head_compress_fps4096_0p5_8_20260602_203738",
        ),
        pointllm_repo_path="/root/autodl-tmp/pointLLM",
        point_backbone_config_name="PointTransformer_8192point_2layer",
        force_single_point_proj=False,
        device_map=None,
        torch_dtype=torch.float16,
        data_path="/root/autodl-tmp/pointLLM/data/objaverse_data",
        pointnum=8192,
    )
    limit = int(os.environ.get("BENCH_LIMIT", "10"))
    offset = int(os.environ.get("BENCH_OFFSET", "0"))
    object_id = os.environ.get("BENCH_OBJECT_ID")
    object_ids = {
        value.strip()
        for value in os.environ.get("BENCH_OBJECT_IDS", "").split(",")
        if value.strip()
    }
    tree_name = os.environ.get("BENCH_TREE", "pointllm_wide_45")
    tree_choices = getattr(tree_choice_defs, tree_name)
    all_rows = [json.loads(line) for line in open(BASELINE_JSONL, encoding="utf-8") if line.strip()]
    if object_ids:
        rows = [row for row in all_rows if row["object_id"] in object_ids][:limit]
    elif object_id:
        rows = [row for row in all_rows if row["object_id"] == object_id][:limit]
    else:
        rows = all_rows[offset : offset + limit]
    setup_started = time.perf_counter()
    helpers = load_pointllm_helpers(args.pointllm_repo_path)
    model, tokenizer = load_eagle_model(args)
    shared_past, shared_data, shared_length = initialize_past_key_values(model.language_model)
    model.past_key_values = shared_past
    model.past_key_values_data = shared_data
    model.current_length_data = shared_length
    torch.cuda.synchronize()
    model_setup_time = time.perf_counter() - setup_started

    exact = 0
    baseline_time = 0.0
    eagle_time = 0.0
    preparation_time = 0.0
    baseline_tokens_total = 0
    eagle_tokens_total = 0
    exact_baseline_time = 0.0
    exact_eagle_time = 0.0
    exact_tokens_total = 0
    details = []
    for sample in rows:
        torch.cuda.synchronize()
        preparation_started = time.perf_counter()
        point_clouds = load_point_cloud(args, helpers, model.base_model, sample)
        input_ids, _, baseline_stopping = build_prompt(
            model.base_model, args.base_model_path, tokenizer, helpers, sample["question"]
        )
        _, _, eagle_stopping = build_prompt(
            model.base_model, args.base_model_path, tokenizer, helpers, sample["question"]
        )
        torch.cuda.synchronize()
        sample_preparation_time = time.perf_counter() - preparation_started

        reset_tree_mode(model.language_model)
        torch.cuda.synchronize()
        started = time.perf_counter()
        baseline_ids = input_ids.clone()
        past_key_values = shared_past
        shared_length.zero_()
        for step in range(128):
            if step == 0:
                outputs = model.base_model(
                    input_ids=baseline_ids,
                    point_clouds=point_clouds,
                    past_key_values=past_key_values,
                    output_hidden_states=False,
                    num_logits_to_keep=1,
                )
            else:
                outputs = model.base_model(
                    input_ids=baseline_ids[:, -1:],
                    past_key_values=past_key_values,
                    output_hidden_states=False,
                    num_logits_to_keep=1,
                )
            token = outputs.logits[:, -1].argmax(dim=-1, keepdim=True)
            baseline_ids = torch.cat((baseline_ids, token), dim=1)
            if tokenizer.eos_token_id is not None and int(token.item()) == tokenizer.eos_token_id:
                break
            verdict = baseline_stopping(baseline_ids, None)
            if bool(verdict.item()) if isinstance(verdict, torch.Tensor) else bool(verdict):
                break
        torch.cuda.synchronize()
        base_elapsed = time.perf_counter() - started

        torch.cuda.synchronize()
        started = time.perf_counter()
        eagle_ids, stats = model.eagenerate(
            input_ids=input_ids,
            point_clouds=point_clouds,
            stopping_criteria=[eagle_stopping],
            temperature=0.0,
            max_new_tokens=128,
            max_length=2048,
            tree_choices=tree_choices,
            return_stats=True,
        )
        torch.cuda.synchronize()
        eagle_elapsed = time.perf_counter() - started

        baseline_new = baseline_ids[0, input_ids.shape[1] :].cpu()
        eagle_new = eagle_ids[0, input_ids.shape[1] :].cpu()
        same = torch.equal(baseline_new, eagle_new)
        exact += int(same)
        baseline_token_count = int(baseline_new.numel())
        eagle_token_count = int(eagle_new.numel())
        baseline_text = tokenizer.decode(
            baseline_new.tolist(), skip_special_tokens=True
        )
        eagle_text = tokenizer.decode(
            eagle_new.tolist(), skip_special_tokens=True
        )
        mismatch = None
        if not same:
            common = min(baseline_new.numel(), eagle_new.numel())
            unequal = torch.where(baseline_new[:common] != eagle_new[:common])[0]
            mismatch = int(unequal[0]) if unequal.numel() else common
        window_start = max(0, (mismatch or 0) - 3)
        window_end = min(
            max(baseline_new.numel(), eagle_new.numel()),
            (mismatch or 0) + 4,
        )
        baseline_time += base_elapsed
        eagle_time += eagle_elapsed
        preparation_time += sample_preparation_time
        baseline_tokens_total += baseline_token_count
        eagle_tokens_total += eagle_token_count
        if same:
            exact_baseline_time += base_elapsed
            exact_eagle_time += eagle_elapsed
            exact_tokens_total += baseline_token_count
        details.append(
            {
                "object_id": sample["object_id"],
                "question": sample["question"],
                "exact": same,
                "first_mismatch": mismatch,
                "baseline_window": baseline_new[window_start:window_end].tolist()
                if mismatch is not None
                else None,
                "eagle_window": eagle_new[window_start:window_end].tolist()
                if mismatch is not None
                else None,
                "baseline_tokens": baseline_token_count,
                "eagle_tokens": eagle_token_count,
                "baseline_text": baseline_text,
                "eagle_text": eagle_text,
                "mat": stats["mat"],
                "exact_reanchors": stats.get("exact_reanchors", 0),
                "exact_trace": stats.get("exact_trace"),
                "baseline_time": base_elapsed,
                "eagle_time": eagle_elapsed,
                "preparation_time": sample_preparation_time,
                "speedup": base_elapsed / eagle_elapsed,
                "request_speedup_with_preparation": (
                    (sample_preparation_time + base_elapsed)
                    / (sample_preparation_time + eagle_elapsed)
                ),
                "baseline_tokens_per_second": baseline_token_count / base_elapsed,
                "eagle_tokens_per_second": eagle_token_count / eagle_elapsed,
            }
        )
        print(details[-1], flush=True)
        model.ee_layer.reset_kv()
        del outputs, baseline_ids, eagle_ids, baseline_new, eagle_new, point_clouds
        gc.collect()
        torch.cuda.empty_cache()

    print(
        json.dumps(
            {
                "samples": len(rows),
                "token_exact_rate": exact / len(rows),
                "exact_samples": exact,
                "max_new_tokens": 128,
                "timing_scope": (
                    "CUDA-synchronized generation including point encoder and "
                    "prompt prefill; excludes model loading, point-cloud file "
                    "I/O, prompt construction, decoding, and logging"
                ),
                "gpu": torch.cuda.get_device_name(),
                "model_setup_time": model_setup_time,
                "preparation_time": preparation_time,
                "baseline_time": baseline_time,
                "eagle_time": eagle_time,
                "speedup": baseline_time / eagle_time,
                "baseline_request_time_with_preparation": (
                    preparation_time + baseline_time
                ),
                "eagle_request_time_with_preparation": (
                    preparation_time + eagle_time
                ),
                "request_speedup_with_preparation": (
                    (preparation_time + baseline_time)
                    / (preparation_time + eagle_time)
                ),
                "baseline_tokens": baseline_tokens_total,
                "eagle_tokens": eagle_tokens_total,
                "baseline_tokens_per_second": (
                    baseline_tokens_total / baseline_time
                ),
                "eagle_tokens_per_second": eagle_tokens_total / eagle_time,
                "output_length_ratio": (
                    eagle_tokens_total / baseline_tokens_total
                ),
                "exact_output_baseline_time": exact_baseline_time,
                "exact_output_eagle_time": exact_eagle_time,
                "exact_output_speedup": (
                    exact_baseline_time / exact_eagle_time
                    if exact_eagle_time
                    else None
                ),
                "exact_output_tokens": exact_tokens_total,
                "benchmark_wall_time": time.perf_counter() - benchmark_started,
                "details": details,
            },
            indent=2,
        )
    )


if __name__ == "__main__":
    main()
