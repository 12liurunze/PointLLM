def load_checkpoint_tensors_by_prefix(model, checkpoint_dir, prefixes):
    """Load tensors that exist in shard files but may be missing from a stale HF index."""
    wanted = set(model.state_dict().keys())
    patch = {}

    single_bin = os.path.join(checkpoint_dir, "pytorch_model.bin")
    bin_files = []
    if os.path.exists(single_bin):
        bin_files.append(single_bin)
    else:
        bin_files.extend(
            os.path.join(checkpoint_dir, name)
            for name in sorted(os.listdir(checkpoint_dir))
            if name.endswith(".bin")
        )

    for bin_file in bin_files:
        weights = torch.load(bin_file, map_location="cpu")
        for key, value in weights.items():
            if key in wanted and any(key.startswith(prefix) for prefix in prefixes):
                patch[key] = value

    if patch:
        model.load_state_dict(patch, strict=False)
        print(f"[INFO] Manually loaded {len(patch)} tensors from checkpoint shards: {sorted(patch)}")


class PointEeModel(nn.Module):
    """EAGLE-EYE wrapper for PointLLM-style point-cloud language models."""

    def __init__(self, base_model, tokenizer, base_model_name_or_path, ee_model_config_path):
        super().__init__()
        self.base_model = base_model
        self.language_model = base_model.model
        self.lm_head = base_model.lm_head
        self.config = base_model.config
        self.hidden_size = self.lm_head.weight.shape[-1]
        self.vocab_size = self.lm_head.weight.shape[0]
        self.base_model_name_or_path = base_model_name_or_path
        self.tokenizer = tokenizer

        config = EConfig.from_pretrained(ee_model_config_path)
        with open(ee_model_config_path, "r", encoding="utf-8") as f:
            raw_config = json.loads(f.read())
        bias = raw_config.get("bias", True)
        self.ee_layer = Model(config, bias=bias)

        device = self.language_model.layers[-1].self_attn.q_proj.weight.device
        if device != self.lm_head.weight.device:
            self.ee_layer.diff_device = True
            self.ee_layer.headweight = self.lm_head.weight.clone().to(device)
        else:
            self.ee_layer.diff_device = False

        self.ee_layer.to(self.base_model.dtype).to(device)
        self.ee_layer.init_tree()

    def get_tokenizer(self):
        return self.tokenizer

    def _point_token_compression_enabled(self):
        if os.environ.get("DISABLE_POINT_TOKEN_COMPRESSION"):
            return False
        keep_ratio = float(os.environ.get("POINT_TOKEN_KEEP_RATIO", "1.0"))
        summary_count = int(os.environ.get("POINT_TOKEN_SUMMARY_COUNT", "0"))
        return keep_ratio < 1.0 or summary_count > 0

    def _score_point_tokens(self, point_tokens, query):
        text_weight = float(os.environ.get("POINT_TOKEN_TEXT_WEIGHT", "0.5"))
        point_norm = torch.nn.functional.normalize(point_tokens.float(), dim=-1)
        query_norm = torch.nn.functional.normalize(query.float(), dim=0)
        centroid = point_norm.mean(dim=0, keepdim=True)
        score_geom = (point_norm - centroid).pow(2).mean(dim=-1)
        score_text = torch.matmul(point_norm, query_norm)
        return score_geom + text_weight * score_text

    @staticmethod
    def _chunk_mean(values, chunks):
        if values.shape[0] == 0 or chunks <= 0:
            return values[:0]
        chunks = min(chunks, values.shape[0])
        boundaries = torch.linspace(0, values.shape[0], steps=chunks + 1, device=values.device)
        outputs = []
        for start, end in zip(boundaries[:-1], boundaries[1:]):
            s = int(start.item())
            e = int(end.item())
            if e <= s:
                e = min(s + 1, values.shape[0])
            outputs.append(values[s:e].mean(dim=0, keepdim=True))
        return torch.cat(outputs, dim=0)

    @staticmethod
    def _morton_codes(centers, depth):
        if centers.numel() == 0:
            return torch.empty(0, dtype=torch.long, device=centers.device)
        depth = max(1, min(int(depth), 10))
        xyz = centers.float()
        xyz_min = xyz.amin(dim=0, keepdim=True)
        xyz_span = (xyz.amax(dim=0, keepdim=True) - xyz_min).clamp_min(1e-6)
        scale = (1 << depth) - 1
        quantized = (((xyz - xyz_min) / xyz_span) * scale).floor().long()
        codes = torch.zeros(xyz.shape[0], dtype=torch.long, device=xyz.device)
        for bit in range(depth):
            codes |= ((quantized[:, 0] >> bit) & 1) << (3 * bit)
            codes |= ((quantized[:, 1] >> bit) & 1) << (3 * bit + 1)
            codes |= ((quantized[:, 2] >> bit) & 1) << (3 * bit + 2)
        return codes

    def _spatially_diverse_topk(self, scores, centers, count):
        if count <= 0:
            return torch.empty(0, dtype=torch.long, device=scores.device)
        count = min(count, scores.shape[0])
        if centers is None or centers.shape[0] != scores.shape[0]:
            return torch.topk(scores, k=count, largest=True).indices

        depth = int(os.environ.get("POINT_TOKEN_OCTREE_DEPTH", "4"))
        order = torch.argsort(self._morton_codes(centers, depth))
        boundaries = torch.linspace(0, order.shape[0], steps=count + 1, device=order.device)
        selected = []
        for start, end in zip(boundaries[:-1], boundaries[1:]):
            start_idx = int(start.item())
            end_idx = max(start_idx + 1, int(end.item()))
            candidates = order[start_idx:end_idx]
            selected.append(candidates[scores[candidates].argmax()])
        return torch.stack(selected)

    def _octree_summary(self, values, centers, chunks):
        if values.shape[0] == 0 or chunks <= 0:
            return values[:0]
        if centers is None or centers.shape[0] != values.shape[0]:
            return self._chunk_mean(values, chunks)

        chunks = min(chunks, values.shape[0])
        depth = int(os.environ.get("POINT_TOKEN_OCTREE_DEPTH", "4"))
        order = torch.argsort(self._morton_codes(centers, depth))
        sorted_values = values.index_select(0, order)
        return self._chunk_mean(sorted_values, chunks)

    def _hierarchical_octree_groups(self, centers, scores, chunks):
        if centers is None or centers.shape[0] == 0 or chunks <= 0:
            return []
        levels = [
            int(value)
            for value in os.environ.get("POINT_TOKEN_HIERARCHY_LEVELS", "1,2,4").split(",")
            if value.strip()
        ]
        levels = [max(1, min(level, 10)) for level in levels] or [1, 2, 4]
        allocations = [1] * len(levels)
        for index in range(chunks - len(levels)):
            allocations[-1 - (index % len(levels))] += 1

        groups = []
        density_weight = float(os.environ.get("POINT_TOKEN_DENSITY_WEIGHT", "0.15"))
        for depth, allocation in zip(levels, allocations):
            codes = self._morton_codes(centers, depth)
            unique_codes = torch.unique(codes)
            ranked_cells = []
            for code in unique_codes:
                members = torch.where(codes == code)[0]
                cell_score = scores[members].max()
                cell_score = cell_score + density_weight * torch.log1p(
                    torch.tensor(float(members.numel()), device=scores.device)
                )
                ranked_cells.append((cell_score, members))
            ranked_cells.sort(key=lambda item: float(item[0]), reverse=True)
            groups.extend(members for _, members in ranked_cells[:allocation])
        return groups[:chunks]

    @staticmethod
    def _pool_semantic_groups(values, scores, groups):
        if not groups:
            return values[:0]
        temperature = float(os.environ.get("POINT_TOKEN_SEMANTIC_TEMPERATURE", "0.25"))
        outputs = []
        for members in groups:
            weights = torch.softmax(scores[members].float() / max(temperature, 1e-4), dim=0)
            pooled = torch.sum(values[members].float() * weights[:, None], dim=0, keepdim=True)
            outputs.append(pooled.to(values.dtype))
        return torch.cat(outputs, dim=0)

    @torch.no_grad()
    def _build_compressed_draft_prompt(self, input_ids, inputs_embeds, hidden_states):
        model = self.base_model.get_model()
        point_cfg = getattr(model, "point_backbone_config", None)
        if inputs_embeds is None or point_cfg is None or not self._point_token_compression_enabled():
            return input_ids, None, None

        keep_ratio = float(os.environ.get("POINT_TOKEN_KEEP_RATIO", "1.0"))
        summary_count = int(os.environ.get("POINT_TOKEN_SUMMARY_COUNT", "0"))
        spatial_mode = os.environ.get("POINT_TOKEN_SPATIAL_MODE", "none").lower()
        group_centers = getattr(model, "last_point_group_centers", None)

        compressed_ids = []
        compressed_embeds = []
        compressed_hidden_states = []
        batch_token_stats = []
        for batch_idx, (cur_ids, cur_embeds, cur_hidden) in enumerate(
            zip(input_ids, inputs_embeds, hidden_states)
        ):
            point_mask = cur_ids == point_cfg["point_patch_token"]
            if int(point_mask.sum().item()) == 0:
                compressed_ids.append(cur_ids)
                compressed_embeds.append(cur_embeds)
                compressed_hidden_states.append(cur_hidden)
                continue
            point_indices = point_mask.nonzero(as_tuple=False).flatten()
            cur_point_features = cur_embeds[point_indices].to(device=cur_embeds.device, dtype=cur_embeds.dtype)
            cur_point_hidden = cur_hidden[point_indices]
            point_count = int(point_indices.numel())
            keep_count = max(1, min(point_count, int(__import__("math").ceil(point_count * keep_ratio))))
            query_tokens = cur_embeds[~point_mask]
            query = query_tokens.mean(dim=0) if query_tokens.numel() > 0 else cur_embeds.mean(dim=0)
            scores = self._score_point_tokens(cur_point_features, query)
            centers = None
            if (
                spatial_mode in {"octree", "hierarchical_octree"}
                and group_centers is not None
                and batch_idx < group_centers.shape[0]
                and point_count == group_centers.shape[1] + 1
            ):
                centers = group_centers[batch_idx].to(cur_embeds.device)
                if keep_count == 1:
                    selected_local = torch.zeros(1, dtype=torch.long, device=cur_ids.device)
                else:
                    group_selected = self._spatially_diverse_topk(
                        scores[1:], centers, keep_count - 1
                    ) + 1
                    selected_local = torch.cat(
                        (torch.zeros(1, dtype=torch.long, device=cur_ids.device), group_selected)
                    ).sort().values
            else:
                selected_local = torch.topk(scores, k=keep_count, largest=True).indices.sort().values
            selected_point_indices = point_indices[selected_local]
            selected_mask = torch.zeros(point_count, dtype=torch.bool, device=cur_ids.device)
            selected_mask[selected_local] = True
            remaining_local = (~selected_mask).nonzero(as_tuple=False).flatten()
            summary_features = cur_point_features[:0]
            summary_hidden = cur_point_hidden[:0]
            summary_ids = cur_ids[:0]
            if summary_count > 0 and remaining_local.numel() > 0:
                remaining_features = cur_point_features[remaining_local]
                remaining_hidden = cur_point_hidden[remaining_local]
                remaining_centers = None
                if centers is not None:
                    group_local = remaining_local[remaining_local > 0] - 1
                    remaining_features = cur_point_features[remaining_local[remaining_local > 0]]
                    remaining_hidden = cur_point_hidden[remaining_local[remaining_local > 0]]
                    remaining_centers = centers[group_local]
                if spatial_mode == "hierarchical_octree" and remaining_centers is not None:
                    remaining_scores = scores[remaining_local[remaining_local > 0]]
                    groups = self._hierarchical_octree_groups(
                        remaining_centers, remaining_scores, summary_count
                    )
                    summary_features = self._pool_semantic_groups(
                        remaining_features, remaining_scores, groups
                    )
                    summary_hidden = self._pool_semantic_groups(
                        remaining_hidden, remaining_scores, groups
                    )
                else:
                    summary_features = self._octree_summary(
                        remaining_features, remaining_centers, summary_count
                    )
                    summary_hidden = self._octree_summary(
                        remaining_hidden, remaining_centers, summary_count
                    )
                summary_ids = torch.full((summary_features.shape[0],), int(point_cfg["point_patch_token"]), dtype=cur_ids.dtype, device=cur_ids.device)
            batch_token_stats.append(
                {
                    "original_point_tokens": point_count,
                    "selected_point_tokens": int(keep_count),
                    "summary_tokens": int(summary_ids.shape[0]),
                    "compressed_point_tokens": int(keep_count + summary_ids.shape[0]),
                }
            )
            keep_sequence_mask = ~point_mask
            keep_sequence_mask[selected_point_indices] = True
            first_point_pos = int(point_indices[0].item())
            prefix_mask = keep_sequence_mask[: first_point_pos + 1]
            suffix_mask = keep_sequence_mask[first_point_pos + 1 :]

            cur_embeds_with_points = cur_embeds.clone()
            cur_embeds_with_points[point_indices] = cur_point_features.to(
                device=cur_embeds.device, dtype=cur_embeds.dtype
            )
            summary_features = summary_features.to(device=cur_embeds.device, dtype=cur_embeds.dtype)
            summary_hidden = summary_hidden.to(device=cur_hidden.device, dtype=cur_hidden.dtype)

            compressed_ids.append(
                torch.cat(
                    (
                        cur_ids[: first_point_pos + 1][prefix_mask],
                        summary_ids,
                        cur_ids[first_point_pos + 1 :][suffix_mask],
                    ),
                    dim=0,
                )
            )
            compressed_embeds.append(
                torch.cat(
                    (
                        cur_embeds_with_points[: first_point_pos + 1][prefix_mask],
                        summary_features,
                        cur_embeds_with_points[first_point_pos + 1 :][suffix_mask],
                    ),
                    dim=0,
                )
            )
            compressed_hidden_states.append(
                torch.cat(
                    (
                        cur_hidden[: first_point_pos + 1][prefix_mask],
                        summary_hidden,
                        cur_hidden[first_point_pos + 1 :][suffix_mask],
                    ),
                    dim=0,
                )
            )
        if len({x.shape[0] for x in compressed_ids}) != 1:
            raise ValueError("Compressed draft prompts in a batch must have the same length.")
        draft_ids = torch.stack(compressed_ids, dim=0)
        draft_embeds = torch.stack(compressed_embeds, dim=0)
        draft_hidden_states = torch.stack(compressed_hidden_states, dim=0)
        spatial_stats = getattr(self.base_model.get_model(), "last_point_spatial_compression", None)
        self.last_point_token_compression = {
            "original_prompt_len": int(input_ids.shape[1]),
            "compressed_prompt_len": int(draft_ids.shape[1]),
            "keep_ratio": keep_ratio,
            "summary_count": summary_count,
            "spatial_mode": spatial_mode,
            "batch": batch_token_stats,
        }
        self.last_point_double_compression = {
            "spatial": spatial_stats,
            "token": self.last_point_token_compression,
        }
        return draft_ids, draft_embeds, draft_hidden_states


    @classmethod
    def from_pretrained(
        cls,
        base_model_path,
        ee_model_path,
        pointllm_repo_path=None,
        tokenizer_path=None,
        point_backbone_config_name=None,
        force_single_point_proj=False,
        **kwargs,
    ):
        if pointllm_repo_path is not None and pointllm_repo_path not in sys.path:
            sys.path.insert(0, pointllm_repo_path)

        tokenizer = AutoTokenizer.from_pretrained(tokenizer_path or base_model_path)
        config = kwargs.pop("config", None) or AutoConfig.from_pretrained(base_model_path)
        attention_backend = os.environ.get("POINT_ATTN_IMPLEMENTATION")
        if attention_backend:
            config._attn_implementation = attention_backend
        if point_backbone_config_name:
            config.point_backbone_config_name = point_backbone_config_name
        if force_single_point_proj:
            config.force_single_point_proj = True
        if not hasattr(config, "_attn_implementation"):
            config._attn_implementation = "eager"
        if not hasattr(config, "attention_dropout"):
            config.attention_dropout = 0.0
        if not hasattr(config, "attention_bias"):
            config.attention_bias = False
        if not hasattr(config, "rope_theta"):
            config.rope_theta = 10000.0
        if not hasattr(config, "rope_scaling"):
            config.rope_scaling = None
        if not hasattr(config, "pretraining_tp"):
            config.pretraining_tp = 1
        if not hasattr(config, "num_key_value_heads"):
            config.num_key_value_heads = config.num_attention_heads
        base_model = PointLLMTreeForCausalLM.from_pretrained(base_model_path, config=config, **kwargs)
        load_checkpoint_tensors_by_prefix(base_model, base_model_path, prefixes=("model.point_proj.",))
        base_model.config.use_cache = True
        base_model.initialize_tokenizer_point_backbone_config_wo_embedding(tokenizer)

        config_path = os.path.join(ee_model_path, "config.json")
        if not os.path.exists(config_path):
            config_path = hf_hub_download(ee_model_path, "config.json")

        model = cls(base_model, tokenizer, base_model_path, config_path)

        weight_path = os.path.join(ee_model_path, "model.safetensors")
        if not os.path.exists(weight_path):
            weight_path = hf_hub_download(ee_model_path, "model.safetensors")
        ee_layer_state_dict = load_file(weight_path, device="cuda")
        model.ee_layer.load_state_dict(ee_layer_state_dict, strict=False)
        return model

    def forward(
        self,
        input_ids=None,
        attention_mask=None,
        labels=None,
        past_key_values=None,
        output_orig=False,
        position_ids=None,
        init=True,
        logits_processor=None,
        point_clouds=None,
        **kwargs,
    ):
        with torch.inference_mode():
            outputs = self.base_model(
                input_ids=input_ids,
                attention_mask=attention_mask,
                past_key_values=past_key_values,
                position_ids=position_ids,
                point_clouds=point_clouds,
                output_hidden_states=True,
                num_logits_to_keep=1 if init else 0,
            )
            hidden_states = outputs["hidden_states"][-1]
            inputs_embeds = outputs["hidden_states"][0]
            target_input_ids = getattr(
                self.base_model.get_model(), "last_target_input_ids", input_ids
            )
            if target_input_ids is None or target_input_ids.shape[1] != hidden_states.shape[1]:
                target_input_ids = input_ids
            draft_input_ids = target_input_ids
            if init:
                self.cached_target_prompt_embeds = inputs_embeds.detach()
            if init and point_clouds is not None and past_key_values is not None:
                if target_input_ids.shape[1] != input_ids.shape[1]:
                    draft_inputs_embeds = inputs_embeds
                    draft_hidden_states = hidden_states
                else:
                    draft_input_ids, draft_inputs_embeds, draft_hidden_states = (
                        self._build_compressed_draft_prompt(input_ids, inputs_embeds, hidden_states)
                    )
                if draft_inputs_embeds is not None:
                    if os.environ.get("POINT_DRAFT_RECOMPUTE_HIDDEN"):
                        draft_outputs = self.base_model(
                            input_ids=draft_input_ids,
                            inputs_embeds=draft_inputs_embeds,
                            output_hidden_states=True,
                        )
                        hidden_states = draft_outputs["hidden_states"][-1]
                        inputs_embeds = draft_outputs["hidden_states"][0]
                    else:
                        hidden_states = draft_hidden_states
                        inputs_embeds = draft_inputs_embeds
            if output_orig:
                orig = outputs["logits"]

        if init:
            if logits_processor is not None:
                logits = logits_processor(None, orig[:, -1])
                probabilities = torch.nn.functional.softmax(logits, dim=1)
                token = torch.multinomial(probabilities, 1)
            else:
                token = torch.argmax(orig[:, -1], dim=-1, keepdim=True)

            input_ids = torch.cat((input_ids, token.to(input_ids.device)), dim=1)
            draft_input_ids = torch.cat((draft_input_ids, token.to(draft_input_ids.device)), dim=1)
            self.generation_input_ids = target_input_ids.clone()
            self.draft_input_ids = draft_input_ids[:, :-1].clone()
            inputs_embeds = torch.cat(
                (
                    inputs_embeds,
                    self.ee_layer.embed_tokens(token).to(inputs_embeds.device),
                ),
                dim=1,
            )

            ea_logits = self.ee_layer.topK_genrate(
                hidden_states=hidden_states,
                input_ids=draft_input_ids,
                inputs_embeds=inputs_embeds,
                model=self.base_model,
                head=self.lm_head,
                logits_processor=logits_processor,
            )
            if output_orig:
                return ea_logits, outputs, orig, hidden_states, token
            return ea_logits, hidden_states, token

        if output_orig:
            return outputs, orig, hidden_states
        return outputs

    @torch.no_grad()
    def eagenerate(
        self,
        input_ids,
        point_clouds=None,
        attention_mask=None,
        stopping_criteria=None,
        temperature=0.0,
        top_p=0.0,
        top_k=0.0,
        max_new_tokens=512,
        max_length=4096,
        tree_choices=mc_sim_7b_63,
        return_stats=False,
        **kwargs,
    ):
        if temperature > 1e-5:
            logits_processor = prepare_logits_processor(
                temperature=temperature, top_p=top_p, top_k=top_k
            )
        else:
            logits_processor = None

        original_input_ids = input_ids.clone()
        input_ids = original_input_ids
        self.ee_layer.reset_kv()
        stopping_criteria = list(stopping_criteria or [])
        profile_enabled = os.environ.get("POINT_PROFILE", "0") == "1"
        profile = {
            "initialize": 0.0,
            "candidates": 0.0,
            "tree_verify": 0.0,
            "posterior": 0.0,
            "update_and_draft": 0.0,
        }
        adaptive_enabled = os.environ.get("POINT_ADAPTIVE_TREE", "0") == "1"
        adaptive_tree_counts = {"narrow": 0, "medium": 0, "wide": 0}

        def profile_start():
            if profile_enabled:
                torch.cuda.synchronize()
                return time.perf_counter()
            return None

        def profile_end(name, started):
            if started is not None:
                torch.cuda.synchronize()
                profile[name] += time.perf_counter() - started

        if hasattr(self, "tree_choices") and self.tree_choices == tree_choices:
            tree_buffers = self.tree_buffers
        else:
            self.ee_layer.tree = tree_choices
            self.ee_layer.tree_buffer = generate_draft_tree_buffers(
                tree_choices,
                device=self.ee_layer.embed_tokens.weight.device,
            )
            tree_buffers = generate_tree_buffers(
                tree_choices,
                device=self.language_model.layers[-1].self_attn.q_proj.weight.device,
            )
            tree_buffers["retrieve_indices_head"] = tree_buffers["retrieve_indices"].to(
                self.lm_head.weight.device
            )
        self.tree_buffers = tree_buffers
        self.tree_choices = tree_choices
        current_tree_buffers = tree_buffers
        adaptive_buffers = None
        if adaptive_enabled:
            tree_defs = {
                "narrow": ADAPTIVE_NARROW_TREE,
                "medium": ADAPTIVE_MEDIUM_TREE,
                "wide": tree_choices,
            }
            adaptive_buffers = {}
            for name, choices in tree_defs.items():
                target_buffers = generate_tree_buffers(
                    choices,
                    device=self.language_model.layers[-1].self_attn.q_proj.weight.device,
                )
                target_buffers["retrieve_indices_head"] = target_buffers["retrieve_indices"].to(
                    self.lm_head.weight.device
                )
                adaptive_buffers[name] = {
                    "choices": choices,
                    "target": target_buffers,
                    "draft": generate_draft_tree_buffers(
                        choices,
                        device=self.ee_layer.embed_tokens.weight.device,
                    ),
                }
            current_tree_buffers = adaptive_buffers["wide"]["target"]
            self.ee_layer.tree = adaptive_buffers["wide"]["choices"]
            self.ee_layer.tree_buffer = adaptive_buffers["wide"]["draft"]

        if hasattr(self, "past_key_values"):
            past_key_values = self.past_key_values
            past_key_values_data = self.past_key_values_data
            current_length_data = self.current_length_data
            current_length_data.zero_()
        else:
            past_key_values, past_key_values_data, current_length_data = initialize_past_key_values(
                self.language_model
            )
            self.past_key_values = past_key_values
            self.past_key_values_data = past_key_values_data
            self.current_length_data = current_length_data

        reset_tree_mode(self.language_model)

        profile_started = profile_start()
        tree_logits, logits, hidden_state, sample_token = initialize_tree(
            input_ids=input_ids,
            point_clouds=point_clouds,
            model=self,
            tree_attn_mask=current_tree_buffers["tree_attn_mask"],
            past_key_values=past_key_values,
            logits_processor=logits_processor,
        )
        profile_end("initialize", profile_started)
        input_ids = getattr(self, "generation_input_ids", input_ids)
        input_len = input_ids.shape[1]
        prompt_hidden_state = hidden_state.detach()
        exact_reanchor_enabled = os.environ.get("POINT_EXACT_REANCHOR", "0") == "1"
        prompt_kv_snapshots = (
            [data[..., :input_len, :].clone() for data in past_key_values_data]
            if exact_reanchor_enabled
            else None
        )
        spatial_complexity = 0.0
        centers = getattr(self.base_model.get_model(), "last_point_group_centers", None)
        if centers is not None and centers.numel() > 0:
            codes = self._morton_codes(centers[0], depth=2)
            spatial_complexity = float(torch.unique(codes).numel()) / 64.0
        new_token = 0
        accept_lengths = []
        high_accept_streak = 0
        accepted_rank_paths = []
        exact_trace = []
        exact_reanchors = 0

        def finalize_outputs(output_ids):
            if input_len != original_input_ids.shape[1]:
                generated_tokens = output_ids[:, input_len:]
                output_ids = torch.cat(
                    (original_input_ids.to(generated_tokens.device), generated_tokens), dim=1
                )
            if not return_stats:
                return output_ids
            accepted_total = sum(accept_lengths)
            steps = len(accept_lengths)
            return output_ids, {
                "accepted_tokens_total": int(accepted_total),
                "accept_steps": int(steps),
                "mat": (accepted_total / steps) if steps else 0.0,
                "accept_lengths": accept_lengths,
                "profile": profile if profile_enabled else None,
                "adaptive_tree_counts": adaptive_tree_counts if adaptive_enabled else None,
                "spatial_complexity": spatial_complexity,
                "accepted_rank_paths": accepted_rank_paths
                if os.environ.get("POINT_TRACE_PATHS", "0") == "1"
                else None,
                "exact_trace": exact_trace
                if os.environ.get("POINT_TRACE_EXACT", "0") == "1"
                else None,
                "exact_reanchors": exact_reanchors,
            }

        for _ in range(max_length):
            profile_started = profile_start()
            candidates, cart_candidates_prob, tree_candidates = generate_candidates(
                tree_logits=tree_logits,
                tree_indices=current_tree_buffers["tree_indices"],
                retrieve_indices=current_tree_buffers["retrieve_indices"],
                sample_token=sample_token,
                logits_processor=logits_processor,
            )
            profile_end("candidates", profile_started)
            profile_started = profile_start()
            self.language_model.tree_mask = current_tree_buffers["tree_attn_mask"]
            logits, hidden_state_new, outputs = tree_decoding(
                model=self,
                tree_candidates=tree_candidates,
                past_key_values=past_key_values,
                tree_position_ids=current_tree_buffers["tree_position_ids"],
                input_ids=input_ids,
                retrieve_indices=current_tree_buffers["retrieve_indices_head"],
            )
            profile_end("tree_verify", profile_started)
            exact_margin = float(os.environ.get("POINT_EXACT_GREEDY_MARGIN", "0.04"))
            if (
                exact_margin > 0.0
                and os.environ.get("POINT_SCALAR_LOGIT_REVERIFY", "0") == "1"
            ):
                top_values = torch.topk(logits.float(), k=2, dim=-1).values
                uncertain_positions = torch.nonzero(
                    top_values[..., 0] - top_values[..., 1] < exact_margin,
                    as_tuple=False,
                )
                reverified_nodes = set()
                retrieve_indices = current_tree_buffers["retrieve_indices"]
                for candidate_pos in uncertain_positions:
                    candidate_index = int(candidate_pos[0].item())
                    path_index = int(candidate_pos[1].item())
                    node_index = int(
                        retrieve_indices[candidate_index, path_index].item()
                    )
                    if node_index < 0 or node_index in reverified_nodes:
                        continue
                    scalar_logits = self.lm_head(
                        hidden_state_new[:, node_index : node_index + 1]
                    )[0, 0]
                    same_node = retrieve_indices == node_index
                    logits[same_node.to(logits.device)] = scalar_logits
                    reverified_nodes.add(node_index)
            profile_started = profile_start()
            best_candidate, accept_length, sample_p = evaluate_posterior(
                logits=logits,
                candidates=candidates,
                logits_processor=logits_processor,
                cart_candidates_prob=cart_candidates_prob,
                op=tree_logits[2],
                p_indices=current_tree_buffers["p_indices"],
                tree_candidates=tree_candidates,
                b_indices=current_tree_buffers["b_indices"],
            )
            profile_end("posterior", profile_started)
            accept_count = int(
                accept_length.item() if hasattr(accept_length, "item") else accept_length
            )
            locally_reanchored = False
            if exact_reanchor_enabled and exact_margin > 0.0:
                candidate_index = int(
                    best_candidate.item() if hasattr(best_candidate, "item") else best_candidate
                )
                uncertain_index = None
                if accept_count > 0:
                    verified_logits = logits[candidate_index, :accept_count].float()
                    verified_values = torch.topk(verified_logits, k=2, dim=-1).values
                    verified_margins = verified_values[:, 0] - verified_values[:, 1]
                    uncertain = torch.nonzero(
                        verified_margins < exact_margin, as_tuple=False
                    )
                    if uncertain.numel() > 0:
                        uncertain_index = int(uncertain[0].item())
                next_values = torch.topk(sample_p.float(), k=2).values
                next_uncertain = bool(
                    (next_values[0] - next_values[1] < exact_margin).item()
                )
                if uncertain_index is not None or next_uncertain:
                    safe_count = (
                        uncertain_index + 1
                        if uncertain_index is not None
                        else accept_count + 1
                    )
                    safe_tokens = candidates[
                        None, candidate_index, :safe_count
                    ].to(input_ids.device)
                    safe_prefix = torch.cat((input_ids, safe_tokens), dim=1)
                    cached_prompt_embeds = self.cached_target_prompt_embeds
                    generated_ids = safe_prefix[:, input_len:]
                    for cache_data, prompt_snapshot in zip(
                        past_key_values_data, prompt_kv_snapshots
                    ):
                        cache_data[..., :input_len, :].copy_(prompt_snapshot)
                    current_length_data.fill_(input_len)
                    reset_tree_mode(self.language_model)
                    replay_hidden_states = []
                    replay_input_embeds = []
                    exact_outputs = None
                    for replay_index in range(generated_ids.shape[1]):
                        exact_outputs = self.base_model(
                            input_ids=generated_ids[
                                :, replay_index : replay_index + 1
                            ],
                            past_key_values=past_key_values,
                            output_hidden_states=True,
                            num_logits_to_keep=1,
                        )
                        replay_hidden_states.append(
                            exact_outputs.hidden_states[-1]
                        )
                        replay_input_embeds.append(
                            exact_outputs.hidden_states[0]
                        )
                    exact_hidden_states = torch.cat(
                        (prompt_hidden_state, *replay_hidden_states), dim=1
                    )
                    exact_inputs_embeds = torch.cat(
                        (
                            cached_prompt_embeds,
                            *replay_input_embeds,
                        ),
                        dim=1,
                    )
                    sample_token = exact_outputs.logits[:, -1].argmax(
                        dim=-1, keepdim=True
                    )
                    input_ids = safe_prefix
                    self.draft_input_ids = safe_prefix.to(
                        self.ee_layer.embed_tokens.weight.device
                    )
                    topk_input_ids = torch.cat(
                        (
                            self.draft_input_ids,
                            sample_token.to(self.draft_input_ids.device),
                        ),
                        dim=1,
                    )
                    draft_inputs_embeds = torch.cat(
                        (
                            exact_inputs_embeds,
                            self.ee_layer.embed_tokens(sample_token).to(
                                exact_inputs_embeds.device
                            ),
                        ),
                        dim=1,
                    )
                    self.ee_layer.reset_kv()
                    tree_logits = self.ee_layer.topK_genrate(
                        exact_hidden_states,
                        input_ids=topk_input_ids,
                        inputs_embeds=draft_inputs_embeds,
                        model=self.base_model,
                        head=self.lm_head,
                        logits_processor=logits_processor,
                    )
                    new_token += safe_count
                    accept_lengths.append(safe_count - 1)
                    exact_reanchors += 1
                    locally_reanchored = True
            if not locally_reanchored:
                accept_lengths.append(int(accept_length.item() if hasattr(accept_length, "item") else accept_length))
            if os.environ.get("POINT_TRACE_EXACT", "0") == "1":
                candidate_index = int(
                    best_candidate.item() if hasattr(best_candidate, "item") else best_candidate
                )
                accepted_count = accept_lengths[-1] + 1
                accepted_ids = candidates[
                    candidate_index, :accepted_count
                ].detach().cpu().tolist()
                verified_margins = []
                verified_top_ids = []
                if accepted_count > 1:
                    verified_logits = logits[candidate_index, : accepted_count - 1].float()
                    verified_values, verified_indices = torch.topk(verified_logits, k=2, dim=-1)
                    verified_margins = (
                        verified_values[:, 0] - verified_values[:, 1]
                    ).detach().cpu().tolist()
                    verified_top_ids = verified_indices[:, 0].detach().cpu().tolist()
                top_values, top_indices = torch.topk(sample_p.float(), k=2)
                exact_trace.append(
                    {
                        "start": int(input_ids.shape[1] - input_len),
                        "accepted_ids": accepted_ids,
                        "verified_top_ids": verified_top_ids,
                        "verified_margins": verified_margins,
                        "next_id": int(top_indices[0].item()),
                        "next_margin": float((top_values[0] - top_values[1]).item()),
                    }
                )
            if os.environ.get("POINT_TRACE_PATHS", "0") == "1":
                candidate_index = int(
                    best_candidate.item() if hasattr(best_candidate, "item") else best_candidate
                )
                path = current_tree_buffers["retrieve_paths"][candidate_index]
                accepted_rank_paths.append(path[: accept_lengths[-1]])
            if adaptive_enabled:
                accepted = accept_lengths[-1]
                root_logits = tree_logits[1][0].float()
                margin = float((root_logits[0] - root_logits[1]).item())
                narrow_accept = int(os.environ.get("POINT_ADAPTIVE_NARROW_ACCEPT", "3"))
                medium_accept = int(os.environ.get("POINT_ADAPTIVE_MEDIUM_ACCEPT", "1"))
                margin_threshold = float(os.environ.get("POINT_ADAPTIVE_MARGIN", "0.8"))
                complexity_threshold = float(
                    os.environ.get("POINT_ADAPTIVE_COMPLEXITY_THRESHOLD", "0.65")
                )
                high_accept_streak = high_accept_streak + 1 if accepted >= narrow_accept else 0
                if (
                    high_accept_streak >= 2
                    and margin >= margin_threshold
                    and spatial_complexity <= complexity_threshold
                ):
                    next_tree_name = "narrow"
                elif accepted >= medium_accept:
                    next_tree_name = "medium"
                else:
                    next_tree_name = "wide"
                adaptive_tree_counts[next_tree_name] += 1
                next_tree = adaptive_buffers[next_tree_name]
                self.ee_layer.tree = next_tree["choices"]
                self.ee_layer.tree_buffer = next_tree["draft"]
            else:
                next_tree = None
            if not locally_reanchored:
                profile_started = profile_start()
                input_ids, tree_logits, new_token, hidden_state, sample_token = update_inference_inputs(
                    input_ids=input_ids,
                    candidates=candidates,
                    best_candidate=best_candidate,
                    accept_length=accept_length,
                    retrieve_indices=current_tree_buffers["retrieve_indices"],
                    logits_processor=logits_processor,
                    logits=logits,
                    tree_logits=tree_logits,
                    new_token=new_token,
                    past_key_values_data_list=past_key_values_data,
                    current_length_data=current_length_data,
                    model=self,
                    hidden_state=hidden_state,
                    hidden_state_new=hidden_state_new,
                    sample_p=sample_p,
                )
                profile_end("update_and_draft", profile_started)
            if next_tree is not None:
                current_tree_buffers = next_tree["target"]

            generated = input_ids[:, input_len:]
            if generated.numel() > 0 and self.tokenizer.eos_token_id is not None:
                eos_positions = (generated[0] == self.tokenizer.eos_token_id).nonzero(as_tuple=False)
                if eos_positions.numel() > 0:
                    first_eos = eos_positions[0].item()
                    return finalize_outputs(input_ids[:, : input_len + first_eos + 1])

            generated_len = input_ids.shape[1] - input_len
            if generated_len >= max_new_tokens:
                return finalize_outputs(input_ids[:, : input_len + max_new_tokens])

            if input_ids.shape[1] >= max_length:
                return finalize_outputs(input_ids[:, :max_length])

            if stopping_criteria:
                should_stop = False
                for criteria in stopping_criteria:
                    verdict = criteria(input_ids, None)
                    if isinstance(verdict, torch.Tensor):
                        verdict = bool(verdict.item())
                    else:
                        verdict = bool(verdict)
                    if verdict:
                        should_stop = True
                        break
                if should_stop:
                    return finalize_outputs(input_ids)

        return finalize_outputs(input_ids)
